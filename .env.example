# Copy to .env for local development. Never commit .env.
APP_ENV=development
DATABASE_URL=sqlite:///./data.db
BUSINESS_RULES_PATH=config/business-rules.yaml
CORS_ORIGINS=http://localhost:3000

# Frontend server-side API proxy.
BACKEND_URL=http://localhost:8000

# NEAR wallet identity (NEP-413 only; no transaction signing).
MERIDIAN_NEAR_AUTH_RECIPIENT=meridian-dashboard.up.railway.app
MERIDIAN_ADMIN_ACCOUNT_IDS=owner.near
NEAR_MAINNET_RPC_URL=https://rpc.mainnet.near.org
NEAR_TESTNET_RPC_URL=https://rpc.testnet.near.org

# Live research uses DefiLlama public data. NEAR AI analysis is optional.
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=
NEAR_AI_MODEL=zai-org/GLM-5.1-FP8
LIVE_INFERENCE_RESERVE_USD=0.05

# Optional NearBlocks key for higher API limits. Requests are labelled as NearBlocks-sourced.
NEARBLOCKS_API_KEY=
NEARBLOCKS_BASE_URL=https://api.nearblocks.io

# Optional official NEAR Intents Explorer partner JWT. No swap activity is claimed without it.
NEAR_INTENTS_EXPLORER_JWT=

# Tidepool is a community-operated 1Click-compatible sandbox. Dry quote mode only; no key required.
TIDEPOOL_QUOTE_URL=https://www.usetidepool.tech/v0/quote

# Future official NEAR Intents production integration. Leave blank until configured and approved.
NEAR_INTENTS_API_BASE_URL=https://1click.chaindefuser.com
NEAR_INTENTS_API_KEY=

# Safety switches. Both remain disabled in the hackathon demo.
PAYMENTS_ENABLED=false
MAINNET_EXECUTION_ENABLED=false
