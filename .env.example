# Copy to .env for local development. Never commit .env.
APP_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autonomous_research

# Keep external integrations disabled until configured and tested.
NEAR_AI_BASE_URL=
NEAR_AI_API_KEY=
NEAR_INTENTS_API_BASE_URL=
NEAR_INTENTS_API_KEY=
PAYMENTS_ENABLED=false
MAINNET_EXECUTION_ENABLED=false
