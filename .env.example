# Copy to .env for local development. Never commit .env.
APP_ENV=development
DATABASE_URL=sqlite:///./data.db
BUSINESS_RULES_PATH=config/business-rules.yaml
CORS_ORIGINS=http://localhost:3000

# Frontend server-side API proxy.
BACKEND_URL=http://localhost:8000

# Live research uses DefiLlama public data. NEAR AI analysis is optional.
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=
NEAR_AI_MODEL=Qwen/Qwen3.8-27B
LIVE_INFERENCE_RESERVE_USD=0.05

# Tidepool is a community-operated 1Click-compatible testnet sandbox. Dry quote mode only; no key required.
TIDEPOOL_QUOTE_URL=https://www.usetidepool.tech/v0/quote

# Future official NEAR Intents production integration. Leave blank until configured and approved.
NEAR_INTENTS_API_BASE_URL=https://1click.chaindefuser.com
NEAR_INTENTS_API_KEY=

# Safety switches. Both remain disabled in the hackathon demo.
PAYMENTS_ENABLED=false
MAINNET_EXECUTION_ENABLED=false
