# Copy to .env for local development. Never commit .env.
APP_ENV=development
DATABASE_URL=sqlite:///./data.db
BUSINESS_RULES_PATH=config/business-rules.yaml
CORS_ORIGINS=http://localhost:3000

# Frontend server-side API proxy.
BACKEND_URL=http://localhost:8000

# Future integrations. Leave blank until configured and tested.
NEAR_AI_BASE_URL=
NEAR_AI_API_KEY=
NEAR_INTENTS_API_BASE_URL=
NEAR_INTENTS_API_KEY=

# Safety switches. Both remain disabled in the hackathon demo.
PAYMENTS_ENABLED=false
MAINNET_EXECUTION_ENABLED=false
